# Optional: omit these values to run the API with in-memory sample data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional API settings
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Part E.1 only: enable the local slow-request experiment explicitly.
DEMO_FAULT_INJECTION=false
DEMO_DELAY_MS=500

# Part E.2 only: enable the bounded local cardinality demonstration.
CARDINALITY_DEMO_ENABLED=false
CARDINALITY_DEMO_REQUEST_ID_LABEL=false
