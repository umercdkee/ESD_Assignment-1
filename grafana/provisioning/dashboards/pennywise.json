{
  "id": null,
  "uid": "pennywise-observability",
  "title": "Pennywise Observability",
  "tags": ["pennywise", "part-b"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API requests / second by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route) (rate(pennywise_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API server errors / second",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route) (rate(pennywise_http_requests_total{status_code=~\"5..\"}[5m]))", "legendFormat": "{{route}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API p95 latency (1-minute window)",
      "description": "Prometheus estimates p95 from histogram observations during each rolling one-minute window. After a slow period, old observations remain in this moving window for up to one minute. Unit: seconds.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(pennywise_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Expenses created / hour by category",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (category) (increase(pennywise_expenses_created_total[1h]))", "legendFormat": "{{category}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Expenses currently stored",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pennywise_expenses_stored", "legendFormat": "expenses", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node CPU usage (Docker Desktop Linux VM)",
      "description": "This project is running on Windows Docker Desktop. Node Exporter observes the Linux VM available to containers, not Windows host CPU.",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{machine=\"docker-desktop-linux-vm\",mode=\"idle\"}[5m])))", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Node memory used (Docker Desktop Linux VM)",
      "description": "Percentage of memory used on the Linux VM measured by Node Exporter.",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes{machine=\"docker-desktop-linux-vm\"} / node_memory_MemTotal_bytes{machine=\"docker-desktop-linux-vm\"})", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Node filesystem used (Docker Desktop Linux VM)",
      "description": "Percentage used for each filesystem reported by Node Exporter on the Linux VM.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{machine=\"docker-desktop-linux-vm\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{machine=\"docker-desktop-linux-vm\",fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{mountpoint}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Node network receive rate (Docker Desktop Linux VM)",
      "description": "Bytes received per second, by network interface, on the Linux VM reported by Node Exporter.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (device) (rate(node_network_receive_bytes_total{machine=\"docker-desktop-linux-vm\",device!~\"lo|veth.*\"}[5m]))", "legendFormat": "{{device}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API request duration Summary p95 (10-minute window)",
      "description": "Application-side rolling Summary quantile, per route/method/status labels. Unit: seconds. Quantiles are not aggregatable across API replicas.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pennywise_http_request_duration_summary_seconds{quantile=\"0.95\"}", "legendFormat": "{{method}} {{route}} {{status_code}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } }
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] }
}
